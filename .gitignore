# =========================
# Python specific ignored files
# =========================
__pycache__/ # Compiled Python bytecode cache directory
*.py[cod] # Compiled Python bytecode files
*$py.class # Jython compiled class files

# Ignored files related to Python distribution and packaging
build/ # Directory for build artifacts
dist/ # Directory for distribution packages
*.egg-info/ # Python egg metadata directories
.eggs/ # Directory for Python eggs
*.egg # Python egg files
*.dist # Distribution archives

# =========================
# Ignored Virtual Environment directories
# =========================
.env # Common .env file
.env.* # Environment-specific .env files
!.env.example # Keep .env.example (it's a template)
.venv # Common virtual environment directory name
env/ # Another common virtual environment directory name
venv/ # Another common virtual environment directory name
ENV/ # Another common virtual environment directory name

# =========================
# Ignored IDE and Editor specific files
# =========================
.vscode/ # VS Code specific settings
.idea/ # IntelliJ IDEA specific settings
*.swp # Vim swap files
*.swo # Vim swap files

# =========================
# Ignored OS generated files
# =========================
.DS_Store # macOS directory metadata
Thumbs.db # Windows thumbnail cache

# =========================
# Ignored log files
# =========================
*.log # General log files
bus_logs.txt # Specific log file for the Intent Bus worker

# =========================
# Ignored Intent Bus Runtime Data (SQLite files)
# ===============================================
# These files are typically generated at runtime by SQLite.
# They should not be committed to version control.
infrastructure.db # The main SQLite database file
infrastructure.db-wal # SQLite Write-Ahead Log file
infrastructure.db-shm # SQLite shared memory file
*-wal # Wildcard for WAL files
*-shm # Wildcard for SHM files

# Avoid blanket DB ignores (safer for tests)
# *.db
# *.sqlite
# *.sqlite3

# =========================
# Ignored Secrets and sensitive files (CRITICAL)
# ===============================================
# These files contain sensitive information and MUST NOT be committed.
.apikey # File containing the API key
.env.* # All environment files (e.g., .env.production)
*.pem # Private key files (e.g., SSL certificates)
*.key # Private key files
*.crt # Certificate files
*.p12 # PKCS#12 archive files
*.secrets # Files containing generic secrets
.envrc # direnv environment setup file

# =========================
# Ignored Testing and Coverage related files
# =========================================
.coverage # Coverage.py data file
htmlcov/ # HTML coverage report directory
.pytest_cache/ # pytest cache directory
.mypy_cache/ # MyPy static type checker cache
.ruff_cache/ # Ruff linter cache
.tox/ # tox test automation directory

# =========================
# Node.js specific ignored files (future-proofing)
# ===============================================
node_modules/ # Node.js dependency directory

# =========================
# Miscellaneous ignored files
# =========================
*.tmp # Temporary files
*.bak # Backup files
.aider* # Aider AI tool files
