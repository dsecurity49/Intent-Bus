# =========================
# Python specific ignored files
# =========================
# Compiled Python bytecode cache directory
__pycache__/
# Compiled Python bytecode files
*.py[cod]
# Jython compiled class files
*$py.class

# =========================
# Ignored Virtual Environment directories
# =========================
.env
.env.*
!.env.example
.venv
env/
venv/
ENV/

# =========================
# Ignored IDE and Editor specific files
# =========================
.vscode/
.idea/
*.swp
*.swo

# =========================
# Ignored OS generated files
# =========================
.DS_Store
Thumbs.db

# =========================
# Ignored log files
# =========================
*.log
bus_logs.txt

# =========================
# Ignored Intent Bus Runtime Data (SQLite files)
# ===============================================
infrastructure.db
infrastructure.db-wal
infrastructure.db-shm
*-wal
*-shm

# =========================
# Ignored Secrets and sensitive files
# ===============================================
.apikey
*.pem
*.key
*.crt
*.p12
*.secrets
.envrc

# =========================
# Ignored Testing and Coverage related files
# =========================================
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/

# =========================
# Miscellaneous ignored files
# =========================
*.tmp
*.bak
.aider*
